# PrintBar Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It contains real secrets.

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=1.0.0
APP_NAME=PrintBar
DATABASE_ECHO=false

# ─── Database (PostgreSQL via Supabase or self-hosted) ────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Supabase Storage ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your_project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here   # Keep secret — backend only

# Storage bucket names (create these in Supabase dashboard, set to PRIVATE)
STORAGE_BUCKET_PRINT_FILES=print-files
STORAGE_BUCKET_RECEIPTS=receipts
STORAGE_BUCKET_REPORTS=reports
STORAGE_BUCKET_SYSTEM_ASSETS=system-assets

SIGNED_URL_EXPIRY_SECONDS=300

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=replace_with_128_char_random_hex_secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Guest Session ────────────────────────────────────────────────────────────
GUEST_SESSION_EXPIRE_HOURS=24

# ─── Payment Provider ─────────────────────────────────────────────────────────
# mock     — No gateway required. Use "Complete Payment" button in the UI.
# razorpay — Requires RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET below.
PAYMENT_PROVIDER=mock

# Razorpay (required when PAYMENT_PROVIDER=razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret_here   # Keep secret — backend only

PAYMENT_TIMEOUT_MINUTES=15

# ─── WebSocket ────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WS_SECRET=replace_with_64_char_random_hex_secret
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_KIOSK_OFFLINE_THRESHOLD_SECONDS=90

# ─── File Upload Limits ───────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=25
MAX_PAGE_COUNT=500

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_GUEST_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_10_MINUTES=5
RATE_LIMIT_PAYMENT_PER_HOUR=10
RATE_LIMIT_ADMIN_LOGIN_PER_15_MINUTES=5

# ─── File Retention ───────────────────────────────────────────────────────────
FILE_RETENTION_AFTER_COMPLETION_DAYS=30
ABANDONED_UPLOAD_EXPIRY_MINUTES=30
FAILED_UPLOAD_EXPIRY_HOURS=24
CLEANUP_WORKER_INTERVAL_MINUTES=15

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id   # Public — safe in browser

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Monitoring ───────────────────────────────────────────────────────────────
ENABLE_METRICS=true

# ─── Dev Seed (seed_db.py only — never production) ────────────────────────────
SEED_ADMIN_EMAIL=admin@printbar.local
SEED_ADMIN_PASSWORD=YourStrongPassword123!
SEED_ADMIN_NAME=Super Admin
