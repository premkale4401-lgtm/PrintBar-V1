# PrintBar Backend — Environment Variables Template
# The backend will automatically fall back to SQLite and Local Storage if external dependencies are missing.
#
# Copy this file to .env and you can run it immediately on a fresh Raspberry Pi.

# ─── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_VERSION=1.0.0
APP_NAME=PrintBar
DATABASE_ECHO=false

# ─── Database ───────────────────────────
# SQLite is the default database for development.
# For production, use Postgres: postgresql+asyncpg://postgres:your_password@db.your_project.supabase.co:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///printbar.db

# ─── Redis (Optional) ──────────────────────────────────────────────────
# Leave blank to disable Redis in development
REDIS_URL=

# ─── Supabase Storage (Optional) ─────────
# Leave blank to default to local file storage at apps/backend/data/storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Storage Buckets ──────────────────────────────
STORAGE_BUCKET_PRINT_FILES=print-files
STORAGE_BUCKET_RECEIPTS=receipts
STORAGE_BUCKET_REPORTS=reports
STORAGE_BUCKET_SYSTEM_ASSETS=system-assets

# ─── Security Secrets (Development Safe Defaults) ────────────────────
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WS_SECRET=0123456789abcdef0123456789abcdef

# ─── Payment Provider ─────────────────────────────────────────────────────────
# mock     — No gateway required. Use "Complete Payment" button in the UI.
# razorpay — Requires RAZORPAY_KEY_ID and RAZORPAY_KEY_SECRET below.
PAYMENT_PROVIDER=mock

# ─── Frontend Integration ─────────────────────────────────────────────────────
# Allowed origins for CORS (comma separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Dev Seed (seed_db.py only — never production) ────────────────────────────
SEED_ADMIN_EMAIL=admin@printbar.local
SEED_ADMIN_PASSWORD=YourStrongPassword123!
SEED_ADMIN_NAME=Super Admin
