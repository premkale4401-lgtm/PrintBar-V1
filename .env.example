# PrintBar — Environment Variables Template
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# NEVER share production secrets.
#
# All variables without defaults are REQUIRED.
# Variables with defaults can be overridden.

# ─── Application ──────────────────────────────────────────────────────────────
APP_NAME=PrintBar API
APP_VERSION=1.0.0
ENVIRONMENT=development       # development | staging | production
DEBUG=false

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Development: uses the local Docker Compose postgres service.
# Production: use Supabase managed PostgreSQL connection string.
DATABASE_URL=postgresql+asyncpg://printbar:printbar_dev_password@localhost:5432/printbar_dev

# Docker Compose postgres container settings (development only).
POSTGRES_USER=printbar
POSTGRES_PASSWORD=printbar_dev_password
POSTGRES_DB=printbar_dev

# Enable SQLAlchemy query logging (development only, never production).
DATABASE_ECHO=false

# ─── Redis ────────────────────────────────────────────────────────────────────
# Development: uses the local Docker Compose redis service.
# Production: use a managed Redis instance (Redis Cloud, Upstash, etc.).
REDIS_URL=redis://localhost:6379/0

# ─── Supabase Storage ─────────────────────────────────────────────────────────
# Use the SERVICE ROLE key (not the anon key) for server-side operations.
# The anon key must NEVER be used in the backend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage bucket names (must be created in Supabase dashboard).
# All buckets must be set to PRIVATE.
STORAGE_BUCKET_PRINT_FILES=print-files
STORAGE_BUCKET_RECEIPTS=receipts
STORAGE_BUCKET_REPORTS=reports
STORAGE_BUCKET_SYSTEM_ASSETS=system-assets

# Signed URL expiry (seconds). Default: 5 minutes.
SIGNED_URL_EXPIRY_SECONDS=300

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Minimum 32 characters. Use 128+ characters in production.
JWT_SECRET=replace-this-with-a-128-character-cryptographically-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ─── Guest Session ────────────────────────────────────────────────────────────
GUEST_SESSION_EXPIRE_HOURS=24

# ─── Razorpay Payment ─────────────────────────────────────────────────────────
# Obtain from Razorpay Dashboard → Settings → API Keys.
# Use TEST mode credentials for development (prefix: rzp_test_).
# Use LIVE mode credentials for production (prefix: rzp_live_).
#
# KEY_ID is public — safe to expose to the frontend for modal initialization.
# KEY_SECRET is private — NEVER expose to the frontend or commit to version control.
# WEBHOOK_SECRET is private — configure in Razorpay Dashboard → Webhooks.
#   The webhook URL to configure: https://your-domain.com/api/v1/payments/webhook/razorpay
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_signing_secret_here
RAZORPAY_BASE_URL=https://api.razorpay.com/v1
RAZORPAY_CURRENCY=INR

# Payment session timeout (minutes).
PAYMENT_TIMEOUT_MINUTES=15

# ─── WebSocket ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
WS_SECRET=replace-with-websocket-signing-secret
WS_HEARTBEAT_INTERVAL_SECONDS=30
WS_KIOSK_OFFLINE_THRESHOLD_SECONDS=90

# ─── File Upload Limits ───────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=25
MAX_PAGE_COUNT=500

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_GUEST_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_10_MINUTES=5
RATE_LIMIT_PAYMENT_PER_HOUR=10
RATE_LIMIT_ADMIN_LOGIN_PER_15_MINUTES=5

# ─── File Retention ───────────────────────────────────────────────────────────
FILE_RETENTION_AFTER_COMPLETION_DAYS=30
ABANDONED_UPLOAD_EXPIRY_MINUTES=30
FAILED_UPLOAD_EXPIRY_HOURS=24
CLEANUP_WORKER_INTERVAL_MINUTES=15

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
# Only non-secret configuration is exposed to the frontend.
# The backend API URL must be set as a VITE_ prefix variable.
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Production: replace with actual frontend domain only. Never use *.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Monitoring (Future) ──────────────────────────────────────────────────────
ENABLE_METRICS=true
